# API Key para Gemini - Obtén tu clave en https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# API Key para Hugging Face - Obtén tu clave en https://huggingface.co/settings/tokens
VITE_HUGGING_FACE_API_KEY=your_hugging_face_api_key_here

# Configuración del sistema vectorial
VITE_SIMILARITY_THRESHOLD=0.7
VITE_MAX_MODULES_PER_QUERY=5
VITE_EMBEDDING_CACHE_SIZE=1000